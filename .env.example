# Fournisseur : builtin (défaut) ou ascencia
SHAREX_AUTH_PROVIDER="builtin"

# Clé secrète pour les sessions | `bun run setup` la génère automatiquement
AUTH_SECRET=""

# URL de l'authentification
AUTH_URL=""

# Ascencia ID — requis uniquement avec SHAREX_AUTH_PROVIDER=ascencia
ASCENCIA_ISSUER="https://id.ascencia.re"
ASCENCIA_CLIENT_ID=""
ASCENCIA_CLIENT_SECRET=""
# Rôles applicatifs ou plateforme traduits en administrateur ShareX Manager.
# Recommandé : un rôle « admin » propre à l'application dans Ascencia ID,
# plutôt qu'un rôle large comme « authorized » (voir docs/security.md).
ASCENCIA_ADMIN_ROLES="superadmin"

# Premier administrateur du mode builtin, créé par `bun run setup` sans
# question (équivalent de --admin-username / --admin-password). Le mot de
# passe suit la politique de l'écran Sécurité (12 caractères par défaut).
SHAREX_SETUP_ADMIN_USERNAME=""
SHAREX_SETUP_ADMIN_PASSWORD=""

# Port du serveur
PORT=""

# Chemin par défaut si non défini
UPLOAD_PATH=""

# URL de l'API
NEXT_PUBLIC_API_URL=""
# URL publique du site, utilisée par les metadata et les images Open Graph
NEXT_PUBLIC_SITE_URL="https://sxm.ascencia.re"
        
# URL du domaine de l'application
NEXT_PUBLIC_APP_DOMAIN=""

# URL du domaine de l'image
NEXT_PUBLIC_IMAGE_DOMAIN=""

# Origines CORS supplémentaires, séparées par des virgules (facultatif : un
# site vitrine qui appelle l'API publique, par exemple). L'application et le
# domaine d'images sont déjà admis.
CORS_EXTRA_ORIGINS=""

# Envoi d'e-mails (formulaire de contact). Sans SMTP_USER et SMTP_PASS, aucun
# mail ne part. Connexion SMTPS (port 465).
SMTP_HOST=""
SMTP_USER=""
SMTP_PASS=""
# Expéditeur : SMTP_USER par défaut
MAIL_FROM=""
MAIL_FROM_NAME=""
# Destinataire du formulaire de contact
CONTACT_EMAIL=""

# AI Image Gen et transcription de Clip Studio : clé OpenAI (facultatif, elle
# peut aussi se saisir dans le module ; la variable prime).
OPENAI_API_KEY=""
# AI Image Gen : "1" autorise Codex sans bac à sable, seulement sur un hôte
# dont le noyau empêche le bac à sable de démarrer. Jamais réglable depuis le
# navigateur.
AI_IMAGE_GEN_ALLOW_UNSANDBOXED=""

# URL du microservice Minecraft Skin API (Docker: http://minecraft-skin-api:3089, dev local: http://localhost:3089)

# Comptes connectés (Administration > Comptes connectés), tout est facultatif.
# Application OAuth YouTube (Google Cloud Console, « ID client OAuth », type
# « Application Web »). Sans elles, l'identifiant et le secret se saisissent dans
# la page ; l'URI de redirection est <AUTH_URL>/api/connections/youtube/callback.
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
# Facebook (pages) : application Meta de type Business, cas d'usage « Manage
# everything on your Page », configuration Facebook Login for Business (config_id).
# Redirection : <AUTH_URL>/api/connections/facebook/callback.
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
FACEBOOK_CONFIG_ID=""
# Facultative : seconde configuration avec pages_manage_engagement et
# pages_read_user_content en plus, pour le premier commentaire et les miniatures.
FACEBOOK_EXTENDED_CONFIG_ID=""
# Instagram (compte professionnel, « Instagram API with Instagram Login ») :
# l'Instagram app ID et l'Instagram app secret, pas ceux de l'application Meta.
# Redirection : <AUTH_URL>/api/connections/instagram/callback.
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
# Threads : le Threads App ID et le Threads App secret de l'application dédiée.
# Redirection : <AUTH_URL>/api/connections/threads/callback.
THREADS_CLIENT_ID=""
THREADS_CLIENT_SECRET=""
# TikTok : la « Client key » et le « Client secret » de l'application (Login Kit et
# Content Posting API). Redirection : <AUTH_URL>/api/connections/tiktok/callback.
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# Clé de chiffrement des jetons des comptes connectés et des clés d'API des
# modules : 32 octets aléatoires en base64 (openssl rand -base64 32). Sans
# elle, la clé est dérivée d'AUTH_SECRET, et changer AUTH_SECRET oblige alors
# à reconnecter les comptes et à ressaisir les clés des modules.
CONNECTIONS_ENCRYPTION_KEY=""
# Rotation : liste de clés séparées par des virgules, la nouvelle en premier.
# La première chiffre, les suivantes (et CONNECTIONS_ENCRYPTION_KEY) déchiffrent
# encore. Prime sur CONNECTIONS_ENCRYPTION_KEY pour le chiffrement.
CONNECTIONS_ENCRYPTION_KEYS=""

# Clip Studio, voix Microsoft Azure (facultatif) : clé et région d'une
# ressource « Speech ». L'offre gratuite (F0) donne 500 000 caractères par mois.
# Peuvent aussi se saisir dans Clip Studio, page « Voix en ligne ».
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=""
