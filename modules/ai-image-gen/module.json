{
  "name": "ai-image-gen",
  "version": "2.0.0",
  "description": "Studio de génération d'images : agents CLI connectés ou clés API",
  "author": "ShareX Manager",
  "enabled": true,
  "entry": "index.process.ts",
  "icon": "/images/modules/ai-image-gen.png",
  "category": "AI",
  "hasUI": false,
  "supportedFileTypes": [],
  "settings": {
    "default_model": "codex/gpt-image-2",
    "default_size": "1024x1024",
    "default_quality": "medium",
    "default_count": 1,
    "save_to_gallery": false,
    "notes_preprompt": "",
    "default_negative_prompt": "",
    "max_parallel_jobs": 2,
    "clear_after_submit": true
  },
  "functions": {
    "getCatalogue": "user",
    "enhancePrompt": "user",
    "enqueueGeneration": "user",
    "cancelGeneration": "user",
    "getStudioState": "user",
    "importImageFromUrl": "user",
    "getHistory": "user",
    "getStats": "user",
    "deleteHistoryItem": "user",
    "deleteImage": "user",
    "toggleFavorite": "user",
    "assignCollection": "user",
    "sendToGallery": "user",
    "sendAllToGallery": "user",
    "upscale": "user",
    "inspectImages": "user",
    "inspectImageDetail": "user",
    "getCleanImage": "user",
    "listGalleryItems": "user",
    "importGalleryItems": "user",
    "listCollections": "user",
    "saveCollection": "user",
    "deleteCollection": "user",
    "addCollectionAnchor": "user",
    "removeCollectionAnchor": "user",
    "listPipelines": "user",
    "savePipeline": "user",
    "deletePipeline": "user"
  },
  "pages": [
    { "path": "", "title": "Studio", "component": "pages/generate.tsx" },
    { "path": "library", "title": "Bibliothèque", "component": "pages/library.tsx" },
    { "path": "collections", "title": "Séries", "component": "pages/collections.tsx" },
    { "path": "pipelines", "title": "Pipelines", "component": "pages/pipelines.tsx" },
    { "path": "settings", "title": "Moteurs", "component": "pages/settings.tsx" }
  ],
  "navItems": [
    { "title": "AI Image Gen", "icon": "Sparkles" }
  ],
  "gallerySources": [
    {
      "id": "renders",
      "label": "AI Image Gen",
      "description": "Rendus du studio",
      "icon": "Sparkles",
      "list": "listGalleryItems",
      "import": "importGalleryItems"
    }
  ],
  "fileActions": [
    {
      "id": "edit",
      "label": "Retoucher dans le studio",
      "description": "Garde la composition, ne change que ce que vous décrivez",
      "icon": "PenLine",
      "fileTypes": ["png", "jpg", "jpeg", "webp"],
      "maxFiles": 1,
      "page": "",
      "params": { "role": "edit-target" }
    },
    {
      "id": "inspire",
      "label": "S'en inspirer dans le studio",
      "description": "Sert de référence de style ou de sujet pour une nouvelle image",
      "icon": "Sparkles",
      "fileTypes": ["png", "jpg", "jpeg", "webp", "gif"],
      "maxFiles": 4,
      "page": "",
      "params": { "role": "reference" }
    }
  ]
}
