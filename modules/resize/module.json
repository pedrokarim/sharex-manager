{
  "name": "Resize",
  "version": "1.0.0",
  "description": "Redimensionne automatiquement les screenshots",
  "author": "ShareX Manager",
  "enabled": true,
  "entry": "index.process.ts",
  "icon": "https://cdn-icons-png.flaticon.com/512/5821/5821476.png",
  "category": "Édition",
  "hasUI": true,
  "supportedFileTypes": [
    "jpg",
    "jpeg",
    "png",
    "gif",
    "webp"
  ],
  "settings": {
    "maxWidth": 1920,
    "maxHeight": 1080,
    "quality": 90,
    "maintainAspectRatio": true
  }
}
